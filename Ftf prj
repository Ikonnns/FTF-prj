    SingleDoor = "Door"
}

local function ClearMapCacheAndObjects()
    for _, list in pairs(MapCache) do table.clear(list) end
    for _, data in pairs(MapRenderObjects) do
        if data.Highlight and data.Highlight.Parent then data.Highlight:Destroy() end
        if data.TextDrawing and data.TextDrawing.Remove then data.TextDrawing:Remove() end
    end
    table.clear(MapRenderObjects)
end

local function ScanAndVerifyMap()
    ClearMapCacheAndObjects()
    
    local currentMapVal = ReplicatedStorage:FindFirstChild("CurrentMap")
    local mapName = currentMapVal and tostring(currentMapVal.Value) or ""
    if mapName == "" or mapName == "nil" then return end

    if MapMemory[mapName] then
        MapCache = MapMemory[mapName]
        return
    end

    local activeMapFolder = workspace:FindFirstChild(mapName)
    if not activeMapFolder then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj.Name:lower() == mapName:lower() then
                activeMapFolder = obj
                break
            end
        end
    end

    if not activeMapFolder then return end

    for _, descendant in ipairs(activeMapFolder:GetDescendants()) do
        if descendant:IsA("Model") then
            local nameLower = descendant.Name:lower()
            if not nameLower:find("prefab") then
                if descendant:FindFirstChild("ExitDoorTrigger") or descendant:FindFirstChild("ExitArea") then
                    if not table.find(MapCache.ExitDoor, descendant) then table.insert(MapCache.ExitDoor, descendant) end
                elseif descendant:FindFirstChild("MainComputerScript") or descendant:FindFirstChild("ComputerTrigger1") or descendant:FindFirstChild("PCBarrier") or nameLower:find("computer") or nameLower:find("pc") then
                    if not table.find(MapCache.ComputerTable, descendant) then table.insert(MapCache.ComputerTable, descendant) end
                elseif descendant:FindFirstChild("PodTrigger") or descendant:FindFirstChild("PodRoof") or nameLower:find("freezepod") or nameLower:find("pod") then
                    if not table.find(MapCache.FreezePod, descendant) then table.insert(MapCache.FreezePod, descendant) end
                elseif nameLower:find("vent") then
                    if not table.find(MapCache.VentBlock, descendant) then table.insert(MapCache.VentBlock, descendant) end
                elseif (descendant:FindFirstChild("OpeningSide") or descendant:FindFirstChild("DoorTrigger") or nameLower:find("door")) and not descendant:FindFirstChild("ExitDoorTrigger") and not descendant:FindFirstChild("ExitArea") then
                    if not table.find(MapCache.SingleDoor, descendant) then table.insert(MapCache.SingleDoor, descendant) end
                end
            end
        end
    end

    MapMemory[mapName] = MapCache
end

local currentMapVal = ReplicatedStorage:FindFirstChild("CurrentMap")
if currentMapVal then
    currentMapVal.Changed:Connect(function(newVal)
        if newVal and newVal ~= "" then
            task.wait(1.5)
            ScanAndVerifyMap()
        end
    end)
end

