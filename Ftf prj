local MapCache = {
    ComputerTable = {},
    FreezePod = {},
    ExitDoor = {},
    VentBlock = {},
    SingleDoor = {},
}

local MapMemory = {}
local MapRenderObjects = {}
local MapFolder = Instance.new("Folder")
