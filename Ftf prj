local ArrowDrawings = {}

local function ClearArrowDrawing(player)
    if ArrowDrawings[player] then
        if ArrowDrawings[player].Remove then ArrowDrawings[player]:Remove() end
        ArrowDrawings[player] = nil
    end
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        local arrowsMaster = Toggles.ArrowsMaster and Toggles.ArrowsMaster.Value
        local survivorColor = Options.SurvivorArrowColor and Options.SurvivorArrowColor.Value or Color3.fromRGB(0, 255, 0)
        local beastColor = Options.BeastArrowColor and Options.BeastArrowColor.Value or Color3.fromRGB(255, 0, 0)
        local circleRadius = Options.ArrowRadiusSlider and Options.ArrowRadiusSlider.Value or 100

        if not arrowsMaster then
            for _, arrow in pairs(ArrowDrawings) do
                if arrow then arrow.Visible = false end
            end
            return
        end

        local viewportSize = Camera.ViewportSize
        local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and not IsInLobby(player.Character) then
                local char = player.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")

                if hrp and hum and hum.Health > 0 then
                    if not ArrowDrawings[player] then
                        local triangle = Drawing.new("Triangle")
                        triangle.Visible = false
                        triangle.Filled = true
                        triangle.Thickness = 1
                        ArrowDrawings[player] = triangle
                    end

                    local arrow = ArrowDrawings[player]
                    local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                    if not onScreen then
                        local camCFrame = Camera.CFrame
                        local playerPos = hrp.Position
                        local relPos = camCFrame:PointToObjectSpace(playerPos)
                        local angle = math.atan2(relPos.X, -relPos.Z)
                        
                        local arrowX = screenCenter.X + math.sin(angle) * circleRadius
                        local arrowY = screenCenter.Y + math.cos(angle) * circleRadius
                        local arrowPos = Vector2.new(arrowX, arrowY)

                        local direction = (screenCenter - arrowPos).Unit
                        local perp = Vector2.new(-direction.Y, direction.X)
                        local size = 12

                        -- Fixed triangle rotation to point outward correctly
                        arrow.PointA = arrowPos + (direction * size)
                        arrow.PointB = arrowPos - (direction * (size / 2)) + (perp * (size / 2))
                        arrow.PointC = arrowPos - (direction * (size / 2)) - (perp * (size / 2))
                        arrow.Color = IsPlayerBeast(player) and beastColor or survivorColor
                        arrow.Visible = true
                    else
                        arrow.Visible = false
                    end
                else
                    ClearArrowDrawing(player)
                end
            else
                ClearArrowDrawing(player)
            end
        end
    end)
end)

