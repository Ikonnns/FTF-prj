-------------------------------------------------
-- LOBBY BOUNDS CHECK UTILITY
-------------------------------------------------
local LobbyMin = Vector3.new(-33.8, -41.3, -517.4)
local LobbyMax = Vector3.new(415.1, 117.2, -221.1)

-- Normalize min/max properly regardless of coordinate order
local MinBounds = Vector3.new(math.min(LobbyMin.X, LobbyMax.X), math.min(LobbyMin.Y, LobbyMax.Y), math.min(LobbyMin.Z, LobbyMax.Z))
local MaxBounds = Vector3.new(math.max(LobbyMin.X, LobbyMax.X), math.max(LobbyMin.Y, LobbyMax.Y), math.max(LobbyMin.Z, LobbyMax.Z))

local function IsInLobby(character)
    if not character then return false end
    local hrp = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
    if not hrp then return false end
    local pos = hrp.Position
    if pos.X >= MinBounds.X and pos.X <= MaxBounds.X and
       pos.Y >= MinBounds.Y and pos.Y <= MaxBounds.Y and
       pos.Z >= MinBounds.Z and pos.Z <= MaxBounds.Z then
        return true
    end
    return false
end

