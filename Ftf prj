                ChamsColor = Options.DoorChamsColor and Options.DoorChamsColor.Value or Color3.fromRGB(255, 170, 0),
                Name = Toggles.DoorName and Toggles.DoorName.Value,
                NameColor = Options.DoorNameColor and Options.DoorNameColor.Value or Color3.fromRGB(255, 170, 0),
            }
        }

        for catName, catList in pairs(MapCache) do
            local cfg = categories[catName]
            if not cfg then continue end

            for _, instance in pairs(catList) do
                if not instance or not instance.Parent then continue end

                if not MapRenderObjects[instance] then
                    local hl = Instance.new("Highlight")
                    hl.Name = "SolsticeMapHighlight"
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = instance
                    hl.Enabled = false

                    local txt = Drawing.new("Text")
                    txt.Visible = false; txt.Center = true; txt.Outline = true; txt.OutlineColor = Color3.fromRGB(0, 0, 0)

                    MapRenderObjects[instance] = { Highlight = hl, TextDrawing = txt }
                end

                local data = MapRenderObjects[instance]

                if not cfg.Master then
                    if data.Highlight then data.Highlight.Enabled = false end
                    if data.TextDrawing then data.TextDrawing.Visible = false end
                    continue
                end

                local modelPivot = nil
                pcall(function() modelPivot = instance:GetPivot().Position end)
                if not modelPivot then
                    local cf, _ = instance:GetBoundingBox()
                    modelPivot = cf.Position
                end

                if cfg.Chams and data.Highlight then
                    data.Highlight.FillColor = cfg.ChamsColor
                    data.Highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
                    data.Highlight.FillTransparency = 0.5
                    data.Highlight.OutlineTransparency = 0
                    data.Highlight.Enabled = true
                else
                    if data.Highlight then data.Highlight.Enabled = false end
                end

                if cfg.Name and data.TextDrawing and modelPivot then
                    local pos, onScreen = Camera:WorldToViewportPoint(modelPivot)
                    if onScreen then
                        local distance = math.floor((Camera.CFrame.Position - modelPivot).Magnitude)
                        local labelText = MapNamesMap[catName] or catName

                        if cfg.IsComputer and cfg.ProgressToggle then
                            local progVal = instance:FindFirstChild("Progress") or instance:FindFirstChild("Hacked")
                            if progVal and (progVal:IsA("NumberValue") or progVal:IsA("IntValue")) then
                                labelText = string.format("Computer [%d%%]", progVal.Value)
                            elseif progVal and progVal:IsA("BoolValue") then
                                labelText = progVal.Value and "Computer [100%]" or "Computer [0%]"
                            end
                        end

                        data.TextDrawing.Size = 15
                        data.TextDrawing.Text = string.format("%s [%dm]", labelText, distance)
                        data.TextDrawing.Position = Vector2.new(pos.X, pos.Y)
                        data.TextDrawing.Color = cfg.NameColor
                        data.TextDrawing.Visible = true
                    else
                        data.TextDrawing.Visible = false
                    end
                else
                    if data.TextDrawing then data.TextDrawing.Visible = false end
                end
            end
        end
    end)
end)

