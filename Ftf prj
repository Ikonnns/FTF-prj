local function ApplySkyboxPreset(presetName)
    for _, child in pairs(Lighting:GetChildren()) do
        if child:IsA("Sky") then
            child:Destroy()
        end
    end

    if presetName == "Default" or not SkyPresets[presetName] then
        if OriginalSky then
            OriginalSky:Clone().Parent = Lighting
        end
        return
    end

    local newSky = Instance.new("Sky")
    newSky.Name = "SolsticeSky"
    local data = SkyPresets[presetName]
    newSky.SkyboxBk = data.SkyboxBk
    newSky.SkyboxDn = data.SkyboxDn
    newSky.SkyboxFt = data.SkyboxFt
    newSky.SkyboxLf = data.SkyboxLf
