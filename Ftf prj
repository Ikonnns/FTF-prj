local BoxDrawings = {}

local function ClearPlayerDrawing(player)
    if BoxDrawings[player] then
        for _, obj in pairs(BoxDrawings[player]) do
            if obj and obj.Remove then obj:Remove() end
        end
        BoxDrawings[player] = nil
    end
end

local function CreateBoxDrawing(player)
    if BoxDrawings[player] then return end
    local boxOutline = Drawing.new("Square")
    boxOutline.Visible = false; boxOutline.Color = Color3.fromRGB(0, 0, 0); boxOutline.Thickness = 3; boxOutline.Transparency = 1; boxOutline.Filled = false
    local boxMain = Drawing.new("Square")
    boxMain.Visible = false; boxMain.Color = Color3.fromRGB(255, 255, 255); boxMain.Thickness = 1; boxMain.Transparency = 1; boxMain.Filled = false
    BoxDrawings[player] = { Outline = boxOutline, Main = boxMain }
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        local masterEnabled = Toggles.ESPBoxMaster and Toggles.ESPBoxMaster.Value
        local simpleEnabled = Toggles.ESPSimpleBox and Toggles.ESPSimpleBox.Value
        local enhancedEnabled = Toggles.ESPEnhancedBox and Toggles.ESPEnhancedBox.Value
        local survivorColor = Options.SurvivorESPColor and Options.SurvivorESPColor.Value or Color3.fromRGB(0, 255, 0)
        local beastColor = Options.BeastESPColor and Options.BeastESPColor.Value or Color3.fromRGB(255, 0, 0)

        if not masterEnabled or not (simpleEnabled or enhancedEnabled) then
            for _, data in pairs(BoxDrawings) do
                if data.Outline then data.Outline.Visible = false end
                if data.Main then data.Main.Visible = false end
            end
            return
        end

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and not IsInLobby(player.Character) then
                local char = player.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")

                if hrp and hum and hum.Health > 0 then
                    if not BoxDrawings[player] then CreateBoxDrawing(player) end
                    local drawData = BoxDrawings[player]
                    local position, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                    if onScreen then
                        local currentColor = IsPlayerBeast(player) and beastColor or survivorColor
                        local cframe, size = char:GetBoundingBox()
                        local topPos = Camera:WorldToViewportPoint((cframe * CFrame.new(0, size.Y / 2 + 0.5, 0)).Position)
                        local bottomPos = Camera:WorldToViewportPoint((cframe * CFrame.new(0, -size.Y / 2 - 0.5, 0)).Position)
                        
                        local boxHeight = math.abs(topPos.Y - bottomPos.Y)
                        local boxWidth = boxHeight * 0.65
                        local posX = position.X - boxWidth / 2
                        local posY = topPos.Y

                        if simpleEnabled then
                            drawData.Outline.Visible = false
                            drawData.Main.Size = Vector2.new(boxWidth, boxHeight)
                            drawData.Main.Position = Vector2.new(posX, posY)
                            drawData.Main.Color = currentColor
                            drawData.Main.Visible = true
                        elseif enhancedEnabled then
                            drawData.Outline.Size = Vector2.new(boxWidth, boxHeight)
                            drawData.Outline.Position = Vector2.new(posX, posY)
                            drawData.Outline.Visible = true
                            drawData.Main.Size = Vector2.new(boxWidth, boxHeight)
                            drawData.Main.Position = Vector2.new(posX, posY)
                            drawData.Main.Color = currentColor
                            drawData.Main.Visible = true
                        end
                    else
                        drawData.Outline.Visible = false
                        drawData.Main.Visible = false
                    end
                else
                    if BoxDrawings[player] then
                        BoxDrawings[player].Outline.Visible = false
                        BoxDrawings[player].Main.Visible = false
                    end
                end
            else
                if BoxDrawings[player] then
                    BoxDrawings[player].Outline.Visible = false
                    BoxDrawings[player].Main.Visible = false
                end
            end
        end
    end)
end)

