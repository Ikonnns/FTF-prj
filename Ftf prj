-- ANTI-VOID CHECKPOINT SYSTEM
-------------------------------------------------
local AntiVoidConnection = nil
local CheckpointThread = nil
local LastSafeCFrame = nil
local AntiVoidThreshold = -50

local function StartCheckpointRecorder()
    if CheckpointThread then return end
    CheckpointThread = task.spawn(function()
        while true do
            local character = LocalPlayer.Character
            if character then
                local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
                if root and root.Position.Y > AntiVoidThreshold then
                    LastSafeCFrame = root.CFrame
                end
            end
            task.wait(10)
        end
    end)
end

local function StopCheckpointRecorder()
    if CheckpointThread then
        task.cancel(CheckpointThread)
        CheckpointThread = nil
    end
    LastSafeCFrame = nil
end

PlayerUtilitiesGroup:AddToggle("AntiVoid", {
    Text = "Anti-Void",
    Default = false,
    Callback = function(Value)
        if Value then
            StartCheckpointRecorder()
            AntiVoidConnection = RunService.Heartbeat:Connect(function()
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    if hrp.Position.Y < AntiVoidThreshold then
                        if LastSafeCFrame then
                            hrp.CFrame = LastSafeCFrame + Vector3.new(0, 2, 0)
                            Library:Notify("Anti-Void: Saved to recent checkpoint!")
                        else
                            hrp.CFrame = CFrame.new(0, 10, 0)
                            Library:Notify("Anti-Void: Saved to default spawn!")
                        end
                    end
                end
            end)
        else
            StopCheckpointRecorder()
            if AntiVoidConnection then
                AntiVoidConnection:Disconnect()
                AntiVoidConnection = nil
            end
        end
    end
})

